{
  "name": "ose-rules",
  "version": "0.0.0",
  "description": "A reference catalog of governance, planning, agent, and skill artifacts that other repositories may adopt",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "gate:public-safety": "bash scripts/public-safety/check.sh",
    "check:safety": "bash scripts/public-safety/tests/run.sh",
    "check:format": "prettier --check .",
    "check:lint": "markdownlint-cli2",
    "check:metadata": "node scripts/validate-metadata.mjs .",
    "check:budget": "bash scripts/check-word-budget.sh",
    "check:links": "node scripts/check-links.mjs",
    "check:complete": "npm run check:safety && npm run check:format && npm run check:lint && npm run check:metadata && npm run check:budget && npm run check:links"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "smol-toml": "^1.8.0"
  }
}
