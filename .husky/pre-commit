#!/usr/bin/env bash
# What runs here is declared in `repo-config.yml` and dispatched, not copied. The
# surface holds staged-file formatting only (C6): the formatter rewrites the
# staged files and restages them. Every check, test, and scan runs at the
# pull-request surface, so a commit never waits on them.
set -euo pipefail

# Husky puts the relative `node_modules/.bin` on PATH. The formatter runs in a
# snapshot of the index, outside this checkout, where that relative entry finds
# nothing, so the absolute path is supplied.
PATH="${PWD}/node_modules/.bin:${PATH}"
export PATH

exec ./rhino gate run --surface pre-commit
