#!/usr/bin/env bash
# Ordered exactly as repo-config.yml declares for this surface, stopping at the
# first failure. Public safety runs before any formatter or linter has a chance
# to rewrite the file a finding is in.
set -uo pipefail

export OSE_GATE_SURFACE=pre-commit

bash scripts/public-safety/check.sh || exit $?
npx --no-install prettier --check . || exit $?
npx --no-install markdownlint-cli2 || exit $?
node scripts/validate-metadata.mjs . || exit $?
bash scripts/check-word-budget.sh || exit $?
node scripts/check-links.mjs || exit $?
